  "vectors": [
    {
      "id": "encoded-powershell",
      "event": {
        "event_id": "vector-powershell",
        "event_type": "process_start",
        "timestamp": "2026-08-22T12:00:00Z",
        "actor": "user@example.com",
        "attributes": {
          "process_name": "C:\\Windows\\System32\\PowerShell.EXE",
          "command_line": "powershell.exe -EncodedCommand SQBFAFgA"
        }
      },
      "expected_rule_ids": ["CF-ENDPOINT-001"],
      "expected_reasons": [
        "event_type matched \"process_start\"",
        "process_name|endswith matched [\"powershell.exe\",\"pwsh.exe\"]",
        "command_line|contains matched [\" -enc \",\" -encodedcommand \"]"
      ]
    },
