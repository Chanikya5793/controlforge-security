{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "controlforge-marketing",
  "main": "dist/server/worker-entry.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "controlforge.chanakyachowdary.in",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
