#!/bin/sh
set -eu

if [ "${3:-}" != "/" ]; then
  echo "ControlForge must be installed on the running startup volume." >&2
  exit 1
fi

/usr/sbin/chown -R root:wheel /Library/ControlForge "/Library/Application Support/ControlForge"
/bin/chmod 755 /Library/ControlForge /Library/ControlForge/bin /Library/ControlForge/rules
/usr/sbin/chown root:wheel /Library/ControlForge/rules/*.yml
/bin/chmod 644 /Library/ControlForge/rules/*.yml
/bin/chmod 755 /Library/ControlForge/status
/bin/chmod 755 /Library/ControlForge/installer
/bin/chmod 644 /Library/ControlForge/installer/account-server.default.json
/bin/chmod 700 "/Library/Application Support/ControlForge"
/usr/sbin/chown root:wheel \
  "/Library/Application Support/ControlForge/collector.default.yml"
/bin/chmod 644 "/Library/Application Support/ControlForge/collector.default.yml"
collector_config="/Library/Application Support/ControlForge/collector.yml"
collector_default="/Library/Application Support/ControlForge/collector.default.yml"
if [ ! -e "$collector_config" ]; then
  /usr/bin/install -o root -g wheel -m 600 "$collector_default" "$collector_config"
fi
if [ -L "$collector_config" ] || [ ! -f "$collector_config" ]; then
  echo "ControlForge collector configuration is not a regular file." >&2
  exit 1
fi
/usr/sbin/chown root:wheel "$collector_config"
/bin/chmod 755 /Library/ControlForge/bin/controlforge
/bin/chmod 755 /Library/ControlForge/bin/controlforge-runtime
/bin/chmod 600 "$collector_config"
/bin/chmod 644 "/Library/Application Support/ControlForge/agents.yml"
/usr/sbin/chown root:wheel /Library/LaunchDaemons/com.controlforge.agent.plist
/bin/chmod 644 /Library/LaunchDaemons/com.controlforge.agent.plist
/usr/sbin/chown -R root:wheel /Applications/ControlForge.app
/bin/chmod -R go-w /Applications/ControlForge.app
/bin/chmod 755 /Applications/ControlForge.app \
  /Applications/ControlForge.app/Contents \
  /Applications/ControlForge.app/Contents/MacOS \
  /Applications/ControlForge.app/Contents/MacOS/ControlForge
/bin/chmod 644 /Applications/ControlForge.app/Contents/Info.plist

/Library/ControlForge/bin/controlforge agent-provision-account-server

exit 0
