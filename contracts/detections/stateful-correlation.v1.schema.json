{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlforge.dev/contracts/detections/stateful-correlation.v1.schema.json",
  "title": "ControlForge Stateful Correlation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "rule_version",
    "rule_digest",
    "title",
    "severity",
    "tags",
    "event_type",
    "window_minutes",
    "event_threshold",
    "distinct_threshold",
    "byte_threshold",
    "maximum_speed_kph"
  ],
  "properties": {
    "rule_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rule_version": { "type": "integer", "minimum": 1 },
    "rule_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "event_type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "window_minutes": { "type": ["integer", "null"], "minimum": 1 },
    "event_threshold": { "type": ["integer", "null"], "minimum": 1 },
    "distinct_threshold": { "type": ["integer", "null"], "minimum": 1 },
    "byte_threshold": { "type": ["integer", "null"], "minimum": 1 },
    "maximum_speed_kph": { "type": ["number", "null"], "exclusiveMinimum": 0 }
  }
}
