{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlforge.dev/contracts/detections/replay-evaluation.v1.schema.json",
  "title": "ControlForge Alert Replay Evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_event_id",
    "source_event_sha256",
    "evaluated"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "source_event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_event_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evaluated": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "rule_version",
            "rule_digest",
            "title",
            "severity",
            "actor",
            "reasons",
            "tags"
          ],
          "properties": {
            "rule_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "rule_version": { "type": "integer", "minimum": 1 },
            "rule_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "title": { "type": "string", "minLength": 1, "maxLength": 256 },
            "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
            "actor": { "type": "string", "minLength": 1, "maxLength": 320 },
            "reasons": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        }
      ]
    }
  }
}
