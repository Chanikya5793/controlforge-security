{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlforge.dev/contracts/detections/detection-decision.v1.schema.json",
  "title": "ControlForge Detection Decision v1",
  "description": "Runtime-neutral deterministic match projection. Alert storage identifiers remain a separate compatibility concern.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "matched",
    "rule_id",
    "rule_version",
    "rule_digest",
    "title",
    "severity",
    "event_id",
    "actor",
    "reasons",
    "tags",
    "created_at"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "matched": { "const": true },
    "rule_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rule_version": { "type": "integer", "minimum": 1 },
    "rule_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "actor": { "type": "string", "minLength": 1, "maxLength": 320 },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
