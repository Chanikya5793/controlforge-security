{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlforge.dev/contracts/detections/detection-rule.v1.schema.json",
  "title": "ControlForge Detection Rule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rule_version", "title", "detection"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "rule_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "maxLength": 2000 },
    "status": { "type": "string", "minLength": 1, "maxLength": 64 },
    "logsource": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64 },
      "additionalProperties": { "type": "string", "maxLength": 128 }
    },
    "detection": {
      "type": "object",
      "minProperties": 2,
      "required": ["condition"],
      "properties": {
        "condition": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "timeframe": { "type": ["string", "number"] }
      },
      "patternProperties": {
        "^(?!condition$|timeframe$)[A-Za-z0-9_*?-]+$": {
          "oneOf": [
            { "$ref": "#/$defs/selection" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/selection" }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "level": {
      "enum": ["informational", "low", "medium", "high", "critical"]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+(?:\\|(contains|startswith|endswith|re|cidr))?$"
      },
      "additionalProperties": {
        "oneOf": [
          { "type": ["string", "number", "boolean"] },
          {
            "type": "array",
            "minItems": 1,
            "items": { "type": ["string", "number", "boolean"] }
          }
        ]
      }
    }
  }
}
